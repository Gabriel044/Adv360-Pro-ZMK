#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      prnt: parenthesis {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LPAR>, <&kp RPAR>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      brkt: brackets {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LBKT>, <&kp RBKT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      brcs: curly_braces {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LBRC>, <&kp RBRC>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      cond: conditional_operators {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp AMPS>, <&kp PIPE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      left_pl: left_placement {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_left_half>, <&macro_left_third>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      right_pl: right_placement {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_right_half>, <&macro_right_third>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      center_pl: center_pl {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_center_third>, <&macro_center_half>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      ttl_pd: two_thirds_left_prev_display {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_two_third_left>, <&macro_prev_display>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      ttr_nd: two_thirds_right_next_display {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_two_third_right>, <&macro_next_display>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      left_corner: left_corner {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_top_left>, <&macro_bottom_left>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      right_corner: right_corner {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&macro_top_right>, <&macro_bottom_right>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &brkt                                                            &prnt &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &brcs           &kp LGUI &kp LCTRL &kp RGUI  &kp RALT           &cond &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    keypad {
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LGUI &kp LCTRL &kp RGUI  &kp RALT           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      bindings = <
        &kp F1     &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &left_corner                                       &right_corner &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &macro_fs  &trans &trans &trans &trans &trans  &left_pl                                           &right_pl     &trans &trans &trans &trans  &trans  &trans
        &center_pl &trans &trans &trans &trans &trans  &ttl_pd         &trans &trans &trans &trans        &ttr_nd       &trans &trans &trans &trans  &trans  &trans
        &trans     &trans &trans &trans &trans &trans                         &trans &trans                             &trans &trans &trans &trans  &trans  &trans
        &trans     &trans &kp K_PP &kp K_PREV &kp K_NEXT        &trans &trans &trans &trans &trans &trans               &kp K_VOL_UP &kp K_VOL_DN &kp K_MUTE &trans  &trans
      >;
    };
    mod {
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
  };
};
